# Replace tunnelx.example.com with a domain whose DNS A/AAAA records point to your VPS.
tunnelx.example.com {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8080
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        -Server
    }
}
